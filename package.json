{
  "name": "mgb-software",
  "version": "0.1.0",
  "private": true,
  "description": "MGB Software kurumsal sitesi — Next.js App Router",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24.21.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css,md}\"",
    "clean": "rm -rf .next node_modules *.tsbuildinfo"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.9",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "clsx": "2.1.1",
    "gsap": "3.15.0",
    "motion": "14.0.0",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "wrangler": "4.149.0"
  }
}
