{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mgb-software",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // Sırlar (RESEND_API_KEY, CONTACT_FROM_EMAIL, CONTACT_TO_EMAIL) burada
  // değil: `wrangler secret put <AD>` ile Cloudflare'e yazılır. Yerelde
  // `.dev.vars` dosyasından okunur (bkz. .env.example).
  "observability": {
    "enabled": true,
  },
}
